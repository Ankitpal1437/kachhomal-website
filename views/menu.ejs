<% pageTitle = "Menu — Kachhomal Sweets" %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Menu</span>
    <h1>Priced by the kilo, made by the batch.</h1>
    <p>Prices are indicative and vary slightly with dry fruit and ghee rates. Final pricing is confirmed at the time of order.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="menu-tabs">
      <button class="is-active" data-tab="barfi">Barfi</button>
      <button data-tab="laddu">Laddu</button>
      <button data-tab="kaju">Kaju &amp; Dry Fruit</button>
      <button data-tab="namkeen">Namkeen &amp; Sev</button>
      <button data-tab="festival">Festival Boxes</button>
    </div>

    <div class="menu-list is-active" id="barfi">
      <div class="menu-row">
        <div><span class="m-name">Kaju Barfi</span><p class="m-desc">Classic cashew barfi, cut into diamonds, finished with silver leaf.</p></div>
        <span class="m-price">₹ 900 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Pista Barfi</span><p class="m-desc">Ground pistachio set with milk khoya, mild cardamom.</p></div>
        <span class="m-price">₹ 950 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Kesar Barfi</span><p class="m-desc">Saffron-infused milk barfi, a festive counter favourite.</p></div>
        <span class="m-price">₹ 780 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Plain Mawa Barfi</span><p class="m-desc">Traditional khoya barfi, lightly sweetened.</p></div>
        <span class="m-price">₹ 620 / kg</span>
      </div>
    </div>

    <div class="menu-list" id="laddu">
      <div class="menu-row">
        <div><span class="m-name">Besan Laddu</span><p class="m-desc">Roasted gram flour, pure ghee, rolled by hand daily.</p></div>
        <span class="m-price">₹ 560 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Motichoor Laddu</span><p class="m-desc">Fine boondi laddu, soft-set, a wedding-order favourite.</p></div>
        <span class="m-price">₹ 600 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Atta Laddu</span><p class="m-desc">Whole wheat laddu with almonds and pistachio.</p></div>
        <span class="m-price">₹ 640 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Coconut Laddu</span><p class="m-desc">Fresh grated coconut, condensed milk, lightly toasted.</p></div>
        <span class="m-price">₹ 520 / kg</span>
      </div>
    </div>

    <div class="menu-list" id="kaju">
      <div class="menu-row">
        <div><span class="m-name">Kaju Katli</span><p class="m-desc">Our signature — thin-cut cashew fudge with silver leaf.</p></div>
        <span class="m-price">₹ 980 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Kaju Roll</span><p class="m-desc">Cashew fudge rolled with a dry fruit centre.</p></div>
        <span class="m-price">₹ 1020 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Anjeer Roll</span><p class="m-desc">Fig and mixed dry fruit roll, no added sugar.</p></div>
        <span class="m-price">₹ 1150 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Mixed Dry Fruit Barfi</span><p class="m-desc">Almond, cashew, pistachio and dates, pressed and cut.</p></div>
        <span class="m-price">₹ 1200 / kg</span>
      </div>
    </div>

    <div class="menu-list" id="namkeen">
      <div class="menu-row">
        <div><span class="m-name">Bhujiya Sev</span><p class="m-desc">Thin gram-flour sev, lightly spiced, fried fresh daily.</p></div>
        <span class="m-price">₹ 320 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Chivda Mix</span><p class="m-desc">Poha, peanuts, curry leaf and light spice.</p></div>
        <span class="m-price">₹ 340 / kg</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Moong Dal</span><p class="m-desc">Crisp fried moong dal, salt and pepper finish.</p></div>
        <span class="m-price">₹ 360 / kg</span>
      </div>
    </div>

    <div class="menu-list" id="festival">
      <div class="menu-row">
        <div><span class="m-name">Diwali Assorted Box (1 kg)</span><p class="m-desc">Chef's mix of 4 sweets, gift-wrapped.</p></div>
        <span class="m-price">₹ 850 / box</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Wedding Hamper (2 kg)</span><p class="m-desc">Custom selection for wedding favours, bulk pricing available.</p></div>
        <span class="m-price">On enquiry</span>
      </div>
      <div class="menu-row">
        <div><span class="m-name">Corporate Gift Box</span><p class="m-desc">Branded packaging available for bulk corporate orders.</p></div>
        <span class="m-price">On enquiry</span>
      </div>
    </div>

    <div style="margin-top:40px;">
      <a href="/contact" class="btn btn-primary">Order from this Menu</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
