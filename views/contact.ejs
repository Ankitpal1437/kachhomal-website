<% pageTitle = "Order & Enquiry — Kachhomal Sweets" %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Order &amp; enquiry</span>
    <h1>Tell us the occasion. We'll do the weighing.</h1>
    <p>Fill the form for bulk, festival, wedding or corporate orders and our counter will call you back to confirm quantity, pricing and pickup or delivery.</p>
  </div>
</section>

<section>
  <div class="container form-shell">
    <div class="reveal">
      <h3>Visit or Call</h3>
      <ul class="contact-list" style="margin-top:24px;">
        <li><span class="c-label">Address</span><span>Siru Chowk, Ulhasnagar, Maharashtra</span></li>
        <li><span class="c-label">Phone</span><span>+91 XXXXX XXXXX</span></li>
        <li><span class="c-label">Email</span><span>hello@kachhomal.in</span></li>
        <li><span class="c-label">Hours</span><span>8:00 AM – 10:00 PM, all days</span></li>
        <li><span class="c-label">Outlets</span><span>Ulhasnagar No.1, No.2, Camp 5, Siru Chowk</span></li>
      </ul>
      <p style="margin-top:26px; font-size:0.88rem;">Prefer ordering directly? We're also listed on Zomato and Magicpin for select outlets.</p>
    </div>

    <div class="reveal">
      <% if (typeof submitted !== 'undefined' && submitted) { %>
        <div class="alert alert-success">Enquiry mil gayi — dhanyawad! Hamari team aapko jald hi call karegi confirm karne ke liye.</div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/enquiry" method="POST">
        <div class="field">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required />
        </div>
        <div class="field">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" placeholder="10-digit mobile number" required />
        </div>
        <div class="field">
          <label for="occasion">Occasion</label>
          <select id="occasion" name="occasion">
            <option value="Everyday Order">Everyday Order</option>
            <option value="Festival">Festival</option>
            <option value="Wedding">Wedding</option>
            <option value="Corporate Gifting">Corporate Gifting</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="items">Items &amp; Quantity</label>
          <input type="text" id="items" name="items" placeholder="e.g. Kaju Katli 2kg, Motichoor Laddu 1kg" />
        </div>
        <div class="field">
          <label for="message">Additional Notes</label>
          <textarea id="message" name="message" placeholder="Delivery date, packaging preference, outlet, etc."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send Enquiry</button>
        <p class="form-note">We'll call you back within a few hours to confirm your order.</p>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
