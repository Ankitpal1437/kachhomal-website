<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Kachhomal Sweets — Ulhasnagar' %></title>
  <meta name="description" content="Kachhomal Sweets, Ulhasnagar — traditional mithai and namkeen since 1952. Order online for festivals, gifting and weddings." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
