<% pageTitle = "Gallery — Kachhomal Sweets" %>
<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Gallery</span>
    <h1>A look at the counter.</h1>
    <p>From the display case to the festival hampers — a glimpse of what leaves our shop every day.</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="gallery-grid">
      <img class="tall" src="/images/gallery-1.jpg" alt="Sweet shop display counter" />
      <img src="/images/gallery-2.jpg" alt="Close-up of kaju katli" />
      <img src="/images/gallery-3.jpg" alt="Laddus on a clay plate" />
      <img class="wide" src="/images/gallery-4.jpg" alt="Assorted barfi flat lay" />
      <img src="/images/gallery-5.jpg" alt="Festival gift box of sweets" />
      <img class="tall" src="/images/gallery-6.jpg" alt="Bowl of namkeen" />
      <img class="wide" src="/images/gallery-7.jpg" alt="Shop interior with festive decor" />
    </div>
  </div>
</section>

<section class="section-maroon">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Visit us</span>
      <h2>Best experienced in person.</h2>
      <p>Photos only capture so much — the smell of fresh ghee hits you before you're even at the counter.</p>
    </div>
    <a href="/contact" class="btn btn-gold reveal">Find Our Nearest Outlet</a>
  </div>
</section>

<%- include('partials/footer') %>
