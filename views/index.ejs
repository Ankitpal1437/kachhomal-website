<% pageTitle = "Kachhomal Sweets — Traditional Mithai in Ulhasnagar Since 1952" %>
<%- include('partials/header') %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">Ulhasnagar's mithai counter since 1952</span>
      <h1>Sweetness that's been weighed out for three generations.</h1>
      <p class="lede">From kaju katli to festival hampers, every batch at Kachhomal is still made the way it was in 1952 — pure ghee, fresh khoya, and a counter that knows your order before you finish saying it.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Place a Bulk / Festival Order</a>
        <a href="/menu" class="btn btn-ghost">View Menu</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><b>1952</b><span>Established</span></div>
        <div class="stat"><b>4.3 / 5</b><span>Customer Rating</span></div>
        <div class="stat"><b>5+</b><span>Ulhasnagar Outlets</span></div>
      </div>
    </div>
    <div class="hero-media reveal">
      <div class="hero-media-frame">
        <img src="/images/hero-mithai.jpg" alt="Assorted traditional Indian sweets arranged on a platter" />
      </div>
      <div class="badge-stamp">Since<br />1952</div>
    </div>
  </div>
</section>

<div class="scallop"></div>

<section class="section-alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">What we make</span>
      <h2>Four counters, one recipe book.</h2>
      <p>Everything is made fresh in-house daily — nothing is outsourced, nothing sits longer than it should.</p>
    </div>
    <div class="grid-3">
      <div class="card reveal">
        <div class="card-media"><img src="/images/kaju-katli.jpg" alt="Kaju katli sweets with silver leaf" /></div>
        <div class="card-body">
          <span class="card-tag">Signature</span>
          <h3>Kaju Katli</h3>
          <p>Cashew, sugar and a whisper of cardamom — cut thin, finished with silver leaf.</p>
        </div>
      </div>
      <div class="card reveal">
        <div class="card-media"><img src="/images/laddu.jpg" alt="Golden atta laddus garnished with nuts" /></div>
        <div class="card-body">
          <span class="card-tag">Everyday Favourite</span>
          <h3>Laddu</h3>
          <p>Besan, motichoor and atta laddus, rolled fresh each morning.</p>
        </div>
      </div>
      <div class="card reveal">
        <div class="card-media"><img src="/images/namkeen.jpg" alt="Bowl of crispy namkeen" /></div>
        <div class="card-body">
          <span class="card-tag">Savoury Side</span>
          <h3>Namkeen &amp; Sev</h3>
          <p>The crunchy counterpart to every mithai box — sold by weight, made fresh daily.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container split reverse">
    <div class="split-media reveal">
      <img src="/images/shop-front.jpg" alt="Kachhomal sweet shop storefront" />
    </div>
    <div class="reveal">
      <span class="eyebrow">Our story</span>
      <h2>Three generations at the same counter.</h2>
      <p>Kachhomal opened its first counter in Ulhasnagar in 1952, serving a community rebuilding itself after Partition. What started as one shop selling laddu and barfi to neighbours has grown into a name Ulhasnagar reaches for at every wedding, festival and Sunday visit — without changing what made it trusted in the first place.</p>
      <a href="/about" class="btn btn-ghost">Read Our Full Story</a>
    </div>
  </div>
</section>

<section class="section-maroon">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Trusted across Ulhasnagar</span>
      <h2>What the neighbourhood says.</h2>
    </div>
    <div class="rating-strip reveal">
      <div class="rating-item"><b>4.3 / 5</b>Justdial · 600+ reviews</div>
      <div class="rating-item"><b>4.3 / 5</b>Magicpin · 70+ reviews</div>
      <div class="rating-item"><b>73 yrs</b>Serving Ulhasnagar</div>
      <div class="rating-item"><b>5+</b>Outlets across the city</div>
    </div>
  </div>
</section>

<section class="stories-section">
  <div class="container">
    <div class="stories-header reveal">
      <span class="stories-title">Sweet Stories</span>
      <span class="stories-handle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        @gkachhomal
      </span>
    </div>
  </div>

  <!--
    PLACEHOLDER THUMBNAILS: these cards currently reuse existing product
    photos because Instagram doesn't allow automated thumbnail fetching.
    To use real reel screenshots + accurate like/comment counts, see the
    "Update Sweet Stories" section in README.md.
  -->
  <div class="stories-viewport reveal">
    <div class="stories-track">
      <% const stories = [
        { img: "/images/hero-mithai.jpg", likes: 189, comments: 3, url: "https://www.instagram.com/reel/DbahZWxsLju/" },
        { img: "/images/kaju-katli.jpg", likes: 72, comments: 2, url: "https://www.instagram.com/reel/Dap2Vq8MoSk/" },
        { img: "/images/laddu.jpg", likes: 18, comments: 0, url: "https://www.instagram.com/reel/DZ6zUf3xKTh/" },
        { img: "/images/gallery-5.jpg", likes: 36, comments: 2, url: "https://www.instagram.com/reel/DZmM6hIsGQv/" },
        { img: "/images/gallery-4.jpg", likes: 25, comments: 1, url: "https://www.instagram.com/reel/DX4GfoeMcm9/" }
      ]; %>
      <% for (let i = 0; i < 2; i++) { %>
        <% stories.forEach(function(s) { %>
          <a href="<%= s.url %>" target="_blank" rel="noopener" class="story-card">
            <img src="<%= s.img %>" alt="Kachhomal Instagram reel" loading="lazy" />
            <span class="story-play">
              <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <span class="story-stats">
              <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C.9 8.5 2 5 5.5 5c2 0 3.3 1.1 4 2.1.7-1 2-2.1 4-2.1 3.5 0 4.6 3.5 3 7-2.5 4.5-9.5 9-9.5 9z"/></svg><%= s.likes %></span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg><%= s.comments %></span>
            </span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="container" style="margin-top:30px;">
    <a href="https://instagram.com/gkachhomal" target="_blank" rel="noopener" class="btn btn-gold reveal">Follow on Instagram</a>
  </div>
</section>

<div class="scallop-inverse"></div>

<section class="section-alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Planning an order</span>
      <h2>Festival, wedding or everyday box — tell us what you need.</h2>
      <p>Share your quantity, occasion and preferred pickup or delivery date. Our counter will call you back to confirm.</p>
    </div>
    <a href="/contact" class="btn btn-primary reveal">Start an Enquiry</a>
  </div>
</section>

<%- include('partials/footer') %>
