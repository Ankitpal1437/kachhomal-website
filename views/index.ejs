<div class="scallop-inverse"></div>

<section class="section-alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Planning an order</span>
      <h2>Festival, wedding or everyday box — tell us what you need.</h2>
      <p>Share your quantity, occasion and preferred pickup or delivery date. Our counter will call you back to confirm.</p>
    </div>
    <a href="/contact" class="btn btn-primary reveal">Start an Enquiry</a>
  </div>
</section>

<%- include('partials/footer') %>
